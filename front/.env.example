NEXT_PUBLIC_API_URL=http://localhost:3001

# Settear a true para que el front no intente autenticarse con el backend
DISABLE_AUTH=true
# Concierge IA (OpenRouter)
OPENROUTER_API_KEY=
# Opcional — si no se define, usa openrouter/free (router de modelos gratuitos)
# Ejemplo de modelo free específico: meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_MODEL=
