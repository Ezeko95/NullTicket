NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001

# Settear a true para que el front no intente autenticarse con el backend
DISABLE_AUTH=true

# Admin portal (separate cookie: admin_token)
# false/unset = login against POST /login with a seed user where role=admin
# true = mock login using ADMIN_EMAIL / ADMIN_PASSWORD (backend credentials ignored)
ADMIN_MOCK_AUTH=false
ADMIN_EMAIL=admin@nullticket.local
ADMIN_PASSWORD=admin123

# Concierge IA (OpenRouter)
OPENROUTER_API_KEY=
# Opcional — si no se define, usa openrouter/free (router de modelos gratuitos)
# Ejemplo de modelo free específico: meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_MODEL=
